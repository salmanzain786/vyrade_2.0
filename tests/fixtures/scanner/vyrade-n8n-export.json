    {
      "id": "11",
      "name": "Process Brevo Response",
      "type": "n8n-nodes-base.function",
      "position": [
        980,
        0
      ],
      "parameters": {
        "functionCode": "/*\nProcessBrevoResponse:\n- The Send Batch to Brevo node returned a success response for the batch.\n- This node will map each recipient in the original request to an individual result item for logging/tracking.\n- The Brevo response shape can vary; put conservative placeholders when missing.\n*/\n\nconst recipients = $json.recipients || [];\nconst response = $json || {};\n\nconst results = [];\n\n// If Brevo returns a messageId or data per recipient, attempt to use it; otherwise mark as 'sent'\nconst messageId = response.messageId || response['message-id'] || response.id || null;\n\nfor (let i = 0; i < recipients.length; i++) {\n  const r = recipients[i];\n  results.push({ json: {\n    recipient_email: r.recipient_email,\n    first_name: r.first_name || '',\n    last_name: r.last_name || '',\n    status: 'sent',\n    messageId: messageId || null,\n    timestamp: new Date().toISOString()\n  }});\n}\n\nreturn results;"
      },
      "typeVersion": 1
