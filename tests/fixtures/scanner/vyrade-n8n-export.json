        "jsonParameters": true,
        "bodyParametersJson": "={\n  \"sender\": { \"name\": \"PartnerHacks Outreach\", \"email\": \"redacted@example.com\" },\n  \"to\": $json.recipients.map(r => ({ \"email\": r.recipient_email, \"name\": (r.first_name ? `${r.first_name} ${r.last_name || ''}` : undefined) })),\n  \"subject\": \"={{ $json.recipients[0].email_subject || `Partnership offering from PartnerHacks` }}\",\n  \"htmlContent\": \"={{ $json.recipients.map(r => `Hi ${r.first_name || ''},<br><br>${r.email_body || 'Hello, we have a partnership opportunity.'}`).join('<hr/>') }}\",\n  \"headers\": { \"X-Mailer\": \"n8n-bulk-sender\" }\n}"
