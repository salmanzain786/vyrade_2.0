    {
      "id": "8",
      "name": "Group Valid into Batches",
      "type": "n8n-nodes-base.function",
      "position": [
        120,
        0
      ],
      "parameters": {
        "functionCode": "/*\nGroupValidIntoBatches:\n- Receives only items with status === 'valid'\n- Groups them into chunks (batchSize) and returns one item per chunk where json.recipients = [ ...records ]\n*/\n\nconst batchSize = 20; // controlled batch size for sending\n\nconst valid = items.map(i => i.json).filter(r => r && r.status === 'valid');\nconst out = [];\nfor (let i = 0; i < valid.length; i += batchSize) {\n  const chunk = valid.slice(i, i + batchSize);\n  out.push({ json: { recipients: chunk } });\n}\nreturn out;"
      },
      "typeVersion": 1
    },
