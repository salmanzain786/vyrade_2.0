    {
      "id": "4",
      "name": "Prepare Records",
      "type": "n8n-nodes-base.function",
      "position": [
        -600,
        40
      ],
      "parameters": {
        "functionCode": "/*\nPrepareRecords:\n- Reads rows from the connected Google Sheets Source (items input)\n- Reads suppression list from node \"Read Suppression List\" (by reference)\n- Validates recipient_email presence and basic format\n- Applies suppression rules (opt_out column or presence in suppression list)\n- Honors consent_status == 'opted_in' when present\n- Outputs one item per original row with a 'status' field: 'valid'|'invalid'|'suppressed', plus reason\n*/\n\nconst rows = items.map(i => i.json || {});\n\n// Read suppression list rows from upstream node by name\nlet suppressionRows = [];\ntry {\n  const nodeSupp = $node[\"Read Suppression List\"].all();\n  // nodeSupp is an array of items; flatten to jsons\n  suppressionRows = nodeSupp.map(i => i.json || {});\n} catch (e) {\n  suppressionRows = [];\n}\n\nconst suppressionSet = new Set();\nfor (const r of suppressionRows) {\n  const e = (r.email || r.recipient_email || r.email_address || r.Email || r.EmailAddress);\n  if (e) suppressionSet.add(String(e).toLowerCase().trim());\n}\n\nconst emailRegex = /^\\S+@\\S+\\.\\S+$/;\n\nconst out = [];\nfor (let idx = 0; idx < rows.length; idx++) {\n  const r = rows[idx];\n  const email = (r.recipient_email || r.email || r.email_address || r.Email || '').toString().trim();\n  const optOutRaw = (r.opt_out || r.optOut || r.optout || r.opted_out);\n  const optOut = (typeof optOutRaw === 'string') ? optOutRaw.toLowerCase().trim() === 'true' : Boolean(optOutRaw);\n  const consent = (r.consent_status || r.consent || '').toString().trim();\n\n  // Basic presence check\n  if (!email) {\n    out.push({ json: Object.assign({}, r, { status: 'invalid', reason: 'missing_recipient_email', row_number: idx + 1 }) });\n    continue;\n  }\n\n  // Basic format check\n  if (!emailRegex.test(email)) {\n    out.push({ json: Object.assign({}, r, { status: 'invalid', reason: 'invalid_email_format', recipient_email: email, row_number: idx + 1 }) });\n    continue;\n  }\n\n  // Suppression list check\n  if (suppressionSet.has(email.toLowerCase())) {\n    out.push({ json: Object.assign({}, r, { status: 'suppressed', reason: 'in_suppression_list', recipient_email: email, row_number: idx + 1 }) });\n    continue;\n  }\n\n  // Opt-out flag check\n  if (optOut) {\n    out.push({ json: Object.assign({}, r, { status: 'suppressed', reason: 'opt_out_flag_set', recipient_email: email, row_number: idx + 1 }) });\n    continue;\n  }\n\n  // Consent check when present: require 'opted_in'\n  if (consent && consent.length > 0 && consent.toLowerCase() !== 'opted_in') {\n    out.push({ json: Object.assign({}, r, { status: 'suppressed', reason: 'consent_not_opted_in', recipient_email: email, row_number: idx + 1 }) });\n    continue;\n  }\n\n  // Passed all checks: mark valid\n  out.push({ json: Object.assign({}, r, { status: 'valid', recipient_email: email, row_number: idx + 1 }) });\n}\n\nreturn out;"
      },
      "typeVersion": 1
    },
