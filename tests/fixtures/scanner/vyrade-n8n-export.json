    {
      "id": "15",
      "name": "Create Summary",
      "type": "n8n-nodes-base.function",
      "position": [
        2160,
        0
      ],
      "parameters": {
        "functionCode": "/*\nCreate a simple summary of counts: sent, failed, invalid, suppressed, total\nInput: rows from Read Status Sheet (items)\n*/\n\nconst rows = items.map(i => i.json || {});\nlet sent = 0; let failed = 0; let invalid = 0; let suppressed = 0;\nfor (const r of rows) {\n  const t = (r.Type || '').toString().toLowerCase();\n  if (t === 'sent' || t === 'success' || t === 'info') sent++;\n  else if (t === 'failed' || t === 'error') failed++;\n  else if (t === 'invalid_email' || t === 'invalid') invalid++;\n  else if (t === 'suppressed') suppressed++;\n}\nconst total = rows.length;\nconst summary = `Send summary:\\n- Total rows processed: ${total}\\n- Sent: ${sent}\\n- Failed: ${failed}\\n- Invalid: ${invalid}\\n- Suppressed: ${suppressed}`;\n\nreturn [{ json: { Email_Subject: 'Campaign Send Summary', Report_Summary: summary, summary_counts: { total, sent, failed, invalid, suppressed } } }];"
      },
      "typeVersion": 1
    },
